# Copy to backend/.env. Run scripts/setup-local.ps1 to generate local secrets.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=pulsewatch
DB_USER=pulsewatch
DB_PASSWORD=
OPERATOR_KEY=
APP_ENV=local
APPROVED_ORIGINS=["http://127.0.0.1:9001"]
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
DEMO_ENABLED=true
DEMO_ORIGIN=http://127.0.0.1:9001
RETRY_BASE_SECONDS=0.5
RECOVERY_SUCCESSES=2
WORKER_POLL_SECONDS=2
LOG_DIR=logs

